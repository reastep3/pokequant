# ---- Backend (FastAPI) --------------------------------------------------
# Local dev falls back to SQLite when DATABASE_URL is unset.
DATABASE_URL=postgresql+asyncpg://pokequant:pokequant@localhost:5432/pokequant
# Optional. Unset => in-process LRU cache + no distributed job locks.
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
LOG_LEVEL=INFO
API_KEY=change-me-admin-key            # protects /api/v1/admin/*
CORS_ORIGINS=http://localhost:3000

# Pricing oracles (leave blank to run in demo mode with synthetic data)
PARSEBOT_BASE_URL=https://api.parse.bot/v1
PARSEBOT_API_KEY=
PPT_BASE_URL=https://www.pokemonpricetracker.com/api/v2
PPT_API_KEY=

# Grading economics used by the arbitrage + Kelly modules
GRADING_FEE_USD=25.0
GRADING_SHIPPING_USD=8.0
MARKETPLACE_FEE_PCT=0.1325            # eBay-style all-in selling fee
RISK_FREE_RATE=0.045

# Worker
WORKER_ENABLED=true
PRICE_INGEST_INTERVAL_S=86400
POP_INGEST_INTERVAL_S=21600
ANALYTICS_INTERVAL_S=3600

# ---- Frontend (Next.js) -------------------------------------------------
# Server-side fetches use API_INTERNAL_URL (Fly 6PN); the browser uses NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
